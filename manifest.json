{
  "manifest_version": 3,
  "name": "Custom Adblocker",
  "version": "1.9.3",
  "description": "Blocks ads, popups and popunder tabs by behaviour, not just by domain list. One-click on/off, per-site pause.",
  "minimum_chrome_version": "119",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adnetworks",
        "enabled": true,
        "path": "src/rules/adnetworks.json"
      }
    ]
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Turn Custom Adblocker on or off"
    }
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Custom Adblocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
